---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import CallButtons from '../../components/CallButtons.astro';
import { site, waMessages } from '../../data/site';
import { routes, fmtDuration } from '../../data/routes';
import { faqSchema } from '../../lib/schema';

const alternates = [{ lang: 'tr', path: '/' }, { lang: 'en', path: '/en/' }, { lang: 'de', path: '/de/' }];

const svc = [
  { icon: 'plane', t: 'Flughafentransfer Sinop', d: 'Festpreis-Transfer zum und vom Flughafen Sinop (NOP) — rund 60 km und 1 Stunde 5 Minuten von Ayancık. Wir verfolgen Ihren Flug und warten bei Verspätung kostenlos.' },
  { icon: 'beach', t: 'Strand- und Buchtentouren', d: 'Strand von Ayancık, Kuğu Yalısı, ruhige Buchten Richtung Türkeli, Hamsilos-Bucht und die Tatlıca-Wasserfälle bei Erfelek. Halbtags oder ganztags.' },
  { icon: 'village', t: 'Fahrten in die Dörfer', d: 'Alle 64 Dörfer des Landkreises Ayancık. Wichtig, wenn Sie im Familienhaus außerhalb des Zentrums wohnen — öffentliche Verkehrsmittel gibt es dort kaum.' },
  { icon: 'hospital', t: 'Krankenhausfahrten', d: 'Staatliches Krankenhaus Ayancık und Atatürk-Krankenhaus Sinop (55 km). Von Tür zu Tür, mit Hilfe beim Ein- und Aussteigen.' },
  { icon: 'road', t: 'Fernfahrten', d: 'Samsun (218 km), Kastamonu (140 km), Ankara (435 km), İstanbul (630 km). Preis pro Fahrzeug, nicht pro Person — für Familien oft günstig.' },
  { icon: 'package', t: 'Pakete und Einkäufe', d: 'Medikamente, Unterlagen, Lebensmittel oder Hausschlüssel — noch am selben Tag ins Dorf geliefert.' },
];

const faq = [
  { q: 'Wie bestelle ich ein Taxi in Ayancık?', a: `Rufen Sie ${site.phone.displayIntl} an oder schreiben Sie an dieselbe Nummer über WhatsApp. Am schnellsten geht es, wenn Sie Ihren Live-Standort per WhatsApp senden — dann müssen Sie keine Adresse beschreiben. Sie können auf Deutsch schreiben.` },
  { q: 'Wie weit ist der Flughafen Sinop von Ayancık entfernt?', a: 'Etwa 60 km auf der Straße, rund 1 Stunde 5 Minuten. Die gesamte Strecke führt über eine kurvige Küstenstraße; im Winter sollten Sie mehr Zeit einplanen. Wir empfehlen, etwa 3 Stunden vor Abflug zu starten.' },
  { q: 'Sprechen Sie Deutsch?', a: 'Wir sprechen Türkisch. Für Deutsch nutzen wir WhatsApp-Nachrichten — das funktioniert bei Orten, Daten und Uhrzeiten sehr gut. Senden Sie einfach Abholort, Datum, Uhrzeit und Personenzahl.' },
  { q: 'Was kostet eine Fahrt?', a: 'Kurze Fahrten innerhalb von Ayancık werden nach dem offiziellen Taxameter-Tarif berechnet, der von der Gemeinde festgelegt wird und tags wie nachts gleich ist. Für Flughafen-, Krankenhaus- und Fernfahrten vereinbaren wir vorher einen Festpreis — er ändert sich unterwegs nicht, Brücken- und Autobahngebühren sind enthalten.' },
  { q: 'Kann ich mit Karte zahlen?', a: 'Ja, wir nehmen Bargeld und Kreditkarten. Bei Fernfahrten klären wir die Zahlungsweise am besten vorab.' },
  { q: 'Gibt es Nacht- oder Gepäckzuschläge?', a: 'Nein. Es gibt keinen Nachtzuschlag und keine Gebühr für Koffer, Einkaufstüten, Kinderwagen oder einen faltbaren Rollstuhl. Kindersitze sind kostenlos — sagen Sie uns vorher das Alter des Kindes.' },
  { q: 'Wie viele Personen passen ins Auto?', a: 'Vier Fahrgäste plus Fahrer. Bei größeren Gruppen organisieren wir ein zweites Fahrzeug von Kollegen, denen wir vertrauen, und fahren gemeinsam.' },
  { q: 'Holen Sie uns auch am Flughafen Samsun Çarşamba ab?', a: 'Ja. Die Strecke beträgt etwa 250 km und 3,5 Stunden. Samsun hat deutlich bessere internationale Verbindungen als Sinop, deshalb fliegen viele Gäste aus dem Ausland dorthin. Dieser Transfer muss vorab gebucht werden.' },
  { q: 'Brauche ich im Urlaub einen Mietwagen?', a: 'Meist nicht. Das Zentrum von Ayancık und der Strand sind zu Fuß erreichbar, und Mietwagenangebote im Landkreis sind sehr begrenzt. Ein Auto brauchen Sie eigentlich nur für Tagesausflüge zum Akgöl, zur Höhle, zu den Wasserfällen und zu den ruhigeren Buchten — also an wenigen Tagen eines längeren Aufenthalts.' },
  { q: 'Kann man in Ayancık sicher baden?', a: 'An ruhigen Tagen ja. Der Hafen von Ayancık liegt zum offenen Meer, bei Nord- und Nordwestwind baut sich die Welle schnell auf; der Landkreis hat im Jahr etwa 9 Sturmtage. Die Wassertemperatur liegt im Juni und Juli bei durchschnittlich 23–24 °C. Bei unruhigem Meer ist die geschützte Hamsilos-Bucht bei Sinop die sicherere Wahl.' },
];
---
<Base
  lang="de"
  title="Taxi in Ayancık, Sinop | Flughafentransfer 24/7"
  description="Lizenziertes Taxi in Ayancık, Sinop (Türkei), rund um die Uhr. Flughafentransfer, Strandtouren, Dorf- und Fernfahrten. WhatsApp auf Deutsch."
  path="/de/"
  alternates={alternates}
  waMessage={waMessages.de}
  schema={[faqSchema(faq)]}
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="hero__badges">
          <span class="hero__badge"><Icon name="clock" /> Täglich 24 Stunden</span>
          <span class="hero__badge"><Icon name="pin" /> Ayancık + 64 Dörfer</span>
          <span class="hero__badge"><Icon name="shield" /> Lizenzierter Berufsfahrer</span>
        </p>
        <h1>Taxi in Ayancık an der türkischen Schwarzmeerküste</h1>
        <p class="hero__sub">
          Ein einheimisches, lizenziertes Taxi in Ayancık (Provinz Sinop). Flughafentransfer,
          Strand- und Naturausflüge, Krankenhaus- und Dorffahrten — zum Festpreis, der vor
          der Fahrt vereinbart wird. Sie können uns auf Deutsch schreiben.
        </p>
        <a class="hero__phone" href={site.phone.href}>
          <Icon name="phone" /> {site.phone.displayIntl}
        </a>
        <div style="margin-top:1.3rem">
          <CallButtons lang="de" size="lg" waMessage={waMessages.de} showNumber={false} />
        </div>
        <p class="fs-sm" style="margin-top:1rem;color:#8f9bab">
          Am schnellsten finden wir Sie, wenn Sie Ihren Live-Standort per WhatsApp senden.
        </p>
      </div>
      <aside class="hero-card">
        <h2>Kurz gefasst</h2>
        <dl>
          <div><dt>Öffnungszeiten</dt><dd>24/7, ganzjährig</dd></div>
          <div><dt>Ayancık → Flughafen Sinop</dt><dd>60 km · ca. 1 Std. 5 Min.</dd></div>
          <div><dt>Ayancık → Sinop Stadt</dt><dd>55 km · ca. 1 Std.</dd></div>
          <div><dt>Ayancık → Flughafen Samsun</dt><dd>250 km · ca. 3,5 Std.</dd></div>
          <div><dt>Zahlung</dt><dd>Bargeld · Kreditkarte</dd></div>
          <div><dt>Sprachen</dt><dd>Türkisch · Englisch · Deutsch</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" id="leistungen">
    <div class="wrap">
      <p class="eyebrow">Unsere Leistungen</p>
      <h2>Leistungen</h2>
      <div class="grid grid--3" style="margin-top:1.8rem">
        {svc.map((s) => (
          <div class="card">
            <span class="icon-badge"><Icon name={s.icon} /></span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:1.8rem"><a class="btn btn--ghost" href="/de/flughafentransfer-sinop/">Details zum Flughafentransfer <Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Entfernungen</p>
      <h2>Wie weit ist es von Ayancık?</h2>
      <div class="table-wrap" style="margin-top:1.6rem">
        <table>
          <caption>Ungefähre Straßenentfernungen und Fahrzeiten bei normalen Bedingungen.</caption>
          <thead><tr><th scope="col">Ziel</th><th scope="col" class="num">Entfernung</th><th scope="col" class="num">Fahrzeit</th></tr></thead>
          <tbody>
            {[...routes].sort((a,b)=>a.km-b.km).map((r) => (
              <tr><th scope="row" style="font-weight:640">{r.to}</th><td class="num tabnum">{r.km} km</td><td class="num tabnum nowrap">{fmtDuration(r.minutes).replace(' sa',' Std.').replace(' dk',' Min.')}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid--2" style="align-items:center">
        <div>
          <p class="eyebrow">Gut zu wissen</p>
          <h2>Ayancık in der Praxis</h2>
          <p class="lead">
            Eine Stadt mit rund 23.000 Einwohnern dort, wo der Ayancık-Bach ins offene
            Schwarze Meer mündet, im Rücken die Çangal-Wälder. Schön — aber außerhalb des
            Zentrums gibt es kaum öffentlichen Verkehr.
          </p>
        </div>
        <ul class="ticks" style="font-size:1.02rem">
          <li><strong>Kein Flughafenbus.</strong> Zwischen dem Flughafen Sinop und Ayancık gibt es keine öffentliche Verbindung — besonders bei Nachtflügen ist ein vorab gebuchter Transfer die einzige verlässliche Lösung.</li>
          <li><strong>Dörfer schwer erreichbar.</strong> Die Minibusse fahren die 64 Dörfer nur wenige Male täglich an, und die Fahrpläne wechseln mit der Jahreszeit.</li>
          <li><strong>Das Meer kann rau werden.</strong> Der Hafen liegt zum offenen Meer; bei Nordwind baut sich die Welle schnell auf. Die Hamsilos-Bucht (60 km) ist geschützt.</li>
          <li><strong>Waldwege brauchen Ortskenntnis.</strong> Akgöl und die İnaltı-Höhle liegen an unbefestigten Waldwegen mit lückenhaftem Mobilfunkempfang.</li>
          <li><strong>Der September ist der beste Monat.</strong> Das Meer noch warm, die Menschenmengen weg, die Luft frischer.</li>
          <li><strong>Bargeld mitnehmen.</strong> Außerhalb des Zentrums wird Karte nicht überall akzeptiert.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="faq">
    <div class="wrap narrow">
      <p class="eyebrow">FAQ</p>
      <h2>Häufige Fragen</h2>
      <div style="margin-top:1.6rem"><Faq items={faq} open={0} /></div>
    </div>
  </section>

  <section class="section section--ink center">
    <div class="wrap narrow">
      <h2>Brauchen Sie ein Taxi in Ayancık?</h2>
      <p class="lead" style="margin-inline:auto">
        Rufen Sie an oder senden Sie eine WhatsApp-Nachricht mit Standort, Datum und
        Uhrzeit. Dieselbe Nummer, Tag und Nacht.
      </p>
      <div style="margin-top:1.8rem;display:flex;justify-content:center">
        <CallButtons lang="de" size="lg" waMessage={waMessages.de} />
      </div>
      <p class="fs-sm" style="margin-top:1.4rem"><a href="/">Türkçe</a> · <a href="/en/">English</a></p>
    </div>
  </section>
</Base>
