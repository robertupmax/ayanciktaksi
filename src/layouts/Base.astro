---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CallBar from '../components/CallBar.astro';
import { businessSchema, websiteSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path?: string;
  schema?: unknown[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  waMessage?: string;
  /** Her sayfada işletme + website şeması tekrarlanır (yerel SEO için istenen davranış) */
  includeBusiness?: boolean;
}
const {
  title, description, path, schema = [],
  noindex, ogType, publishedTime, modifiedTime, waMessage, includeBusiness = true,
} = Astro.props;

const allSchema = includeBusiness
  ? [businessSchema(), websiteSchema(), ...schema]
  : schema;
---
<!doctype html>
<html lang="tr" prefix="og: https://ogp.me/ns#">
  <head>
    <Seo
      title={title} description={description} path={path}
      schema={allSchema} noindex={noindex}
      ogType={ogType} publishedTime={publishedTime} modifiedTime={modifiedTime}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">İçeriğe geç</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <CallBar waMessage={waMessage} />
  </body>
</html>
