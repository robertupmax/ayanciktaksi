---
import Base from '../../layouts/Base.astro';
import CallButtons from '../../components/CallButtons.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Photo from '../../components/Photo.astro';
import { placePhotos } from '../../data/photos';
import { places } from '../../data/places';
import { site } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

const crumbs = [{ name: 'Anasayfa', href: '/' }, { name: 'Gezilecek Yerler', href: '/gezilecek-yerler/' }];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Ayancık ve çevresinde gezilecek yerler',
  numberOfItems: places.length,
  itemListElement: places.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'TouristAttraction',
      name: p.name,
      description: p.summary,
      url: `${site.url}/gezilecek-yerler/#${p.slug}`,
      containedInPlace: { '@type': 'AdministrativeArea', name: 'Sinop' },
    },
  })),
};
---
<Base
  title="Ayancık ve Çevresinde Gezilecek Yerler | Akgöl, Şelaleler, Koylar"
  description="Ayancık gezilecek yerler: Akgöl, Çangal Ormanları, İnaltı Mağarası, Çamurca ve Aliköy plajları. Mesafeler, ulaşım ve pratik ipuçları."
  path="/gezilecek-yerler/"
  schema={[breadcrumbSchema(crumbs), schema]}
>
  <Breadcrumbs crumbs={crumbs} />
  <div class="page-head">
    <div class="wrap">
      <h1>Ayancık ve çevresinde gezilecek yerler</h1>
      <p class="lead">
        Ormandan denize, mağaradan şelaleye. Çoğuna toplu taşıma yok; yolları biliyoruz,
        hangi saatte nerenin sakin olduğunu da. Bırakır, dönüşte tekrar alırız.
      </p>
      <div style="margin-top:1.4rem"><CallButtons /></div>
    </div>
  </div>

  <section class="section">
    <div class="wrap">
      <ul class="pills" style="margin-bottom:2.4rem">
        {places.map((p) => <li><a class="pill" href={`#${p.slug}`}>{p.name}{p.kmFromAyancik ? ` · ${p.kmFromAyancik} km` : ''}</a></li>)}
      </ul>

      <div class="stack" style="--stack-gap:3rem">
        {places.map((p) => (
          <article id={p.slug} class="card" style="scroll-margin-top:90px;margin-bottom:1.6rem">
            <Photo name={placePhotos[p.slug]} width={900} ratio="16/9" rounded={false} />
            <p class="post-card__tag">{p.category}{p.kmFromAyancik ? ` · Ayancık’tan ${p.kmFromAyancik} km` : ''}</p>
            <h2 style="font-size:1.4rem">{p.name}</h2>
            <p style="color:var(--ink-3);font-size:1.05rem">{p.summary}</p>
            {p.detail.map((d) => <p>{d}</p>)}
            <h3 style="font-size:1rem;margin-top:.8rem">Pratik notlar</h3>
            <ul class="ticks fs-sm" style="margin-bottom:0">{p.tips.map((t) => <li>{t}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink center">
    <div class="wrap narrow">
      <h2>Gitmek istediğiniz yere bırakalım</h2>
      <p class="lead" style="margin-inline:auto">
        Turistik tur düzenlemiyoruz — yaptığımız iş ulaşım. Nereye gitmek istediğinizi
        söyleyin, sizi oraya bırakalım; dönmek istediğinizde arayın, aynı araç gelsin.
        Gidiş-dönüş fiyatı baştan bellidir.
      </p>
      <div style="margin-top:1.8rem;display:flex;justify-content:center">
        <CallButtons size="lg" />
      </div>
    </div>
  </section>
</Base>
