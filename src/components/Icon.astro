  bag: '<path d="M6 7h12l1.5 13h-15L6 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/>',
};
const solid = ['plane', 'village', 'road', 'city', 'star', 'hospital'].includes(name);
---
<svg class={cls} viewBox="0 0 24 24" aria-hidden="true" focusable="false"
  fill={solid ? 'currentColor' : 'none'}
  stroke={solid ? 'none' : 'currentColor'}
  stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"
  set:html={P[name] ?? P.check}></svg>
