---
interface Props { crumbs: { name: string; href: string }[] }
const { crumbs } = Astro.props;
---
<nav class="crumbs wrap" aria-label="Site haritası">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i === crumbs.length - 1
          ? <span aria-current="page">{c.name}</span>
          : <a href={c.href}>{c.name}</a>}
      </li>
    ))}
  </ol>
</nav>
