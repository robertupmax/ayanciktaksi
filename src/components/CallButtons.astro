---
import { site } from '../data/site';
import Icon from './Icon.astro';
interface Props { size?: 'md' | 'lg'; showNumber?: boolean }
const { size = 'md', showNumber = true } = Astro.props;
const lg = size === 'lg' ? ' btn--lg' : '';
---
<div class="btn-row">
  <a class={`btn btn--call${lg}`} href={site.phone.href} data-call="primary">
    <Icon name="phone" /> {showNumber ? site.phone.display : 'Hemen Ara'}
  </a>
</div>
