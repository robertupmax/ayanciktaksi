---
import { site, waMessages } from '../data/site';
import Icon from './Icon.astro';
interface Props { waMessage?: string; size?: 'md' | 'lg'; showNumber?: boolean }
const { waMessage, size = 'md', showNumber = true } = Astro.props;
const msg = waMessage ?? waMessages.general;
const lg = size === 'lg' ? ' btn--lg' : '';
---
<div class="btn-row">
  <a class={`btn btn--call${lg}`} href={site.phone.href}>
    <Icon name="phone" /> {showNumber ? site.phone.display : 'Hemen Ara'}
  </a>
  <a class={`btn btn--wa${lg}`} href={site.whatsapp.href(msg)} target="_blank" rel="noopener">
    <Icon name="whatsapp" /> WhatsApp’tan Yaz
  </a>
</div>
