---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import CallButtons from '../../components/CallButtons.astro';
import { site, waMessages } from '../../data/site';
import { routes, fmtDuration } from '../../data/routes';
import { faqSchema } from '../../lib/schema';

const alternates = [{ lang: 'tr', path: '/' }, { lang: 'en', path: '/en/' }, { lang: 'de', path: '/de/' }];

const svc = [
  { icon: 'plane', t: 'Sinop Airport transfers', d: 'Fixed-price transfers to and from Sinop Airport (NOP), about 60 km / 1 h 5 min from Ayancık. We track your flight and wait free of charge if it is delayed.' },
  { icon: 'beach', t: 'Beach and cove day trips', d: 'Ayancık beach, Kuğu Yalısı, the quiet coves towards Türkeli, Hamsilos Bay and Erfelek Tatlıca Waterfalls. Half-day or full-day, drop-off or driver stays with you.' },
  { icon: 'village', t: 'Village transfers', d: 'All 64 villages of Ayancık district. Useful if you are staying in a family house outside the town centre — there is almost no public transport.' },
  { icon: 'hospital', t: 'Hospital trips', d: 'Ayancık State Hospital and Sinop Atatürk State Hospital (55 km). Door-to-door, with help getting in and out of the car.' },
  { icon: 'road', t: 'Long-distance rides', d: 'Samsun (218 km), Kastamonu (140 km), Ankara (435 km), İstanbul (630 km). Priced per car, not per person — often competitive for families.' },
  { icon: 'package', t: 'Parcels and shopping', d: 'Medicine, documents, groceries or house keys delivered to a village address the same day.' },
];

const faq = [
  { q: 'How do I get a taxi in Ayancık?', a: `Call ${site.phone.displayIntl} or send a WhatsApp message to the same number. Sharing your live location on WhatsApp is the fastest way — you do not need to describe the address. You can write in English; written messages are easier than a phone call.` },
  { q: 'How far is Sinop Airport from Ayancık?', a: 'About 60 km by road, roughly 1 hour 5 minutes. The whole route is a winding coastal road, so allow extra time in winter. We recommend leaving about 3 hours before departure.' },
  { q: 'Do you speak English?', a: 'We speak Turkish. For English we use WhatsApp written messages, which works well for locations, dates and times. Just send your pickup point, date, time and number of passengers.' },
  { q: 'How much does it cost?', a: 'Short rides inside Ayancık use the official taximeter tariff, which is set by the municipality and is the same day and night. For airport, hospital and long-distance trips we agree a fixed price before departure — it does not change on the way, and bridge and motorway tolls are included.' },
  { q: 'Can I pay by card?', a: 'Yes, we accept cash and credit cards. For long-distance trips it is best to agree the payment method in advance.' },
  { q: 'Is there an extra charge at night or for luggage?', a: 'No. There is no night surcharge and no charge for suitcases, shopping bags, a pram or a folding wheelchair. Child seats are free — just tell us the child’s age in advance.' },
  { q: 'How many passengers fit in the car?', a: 'Four passengers plus the driver. For larger groups we arrange a second car with colleagues we trust and travel together.' },
  { q: 'Can you pick us up from Samsun Çarşamba Airport?', a: 'Yes. It is about 250 km and 3.5 hours from Ayancık. Samsun has considerably better international connections than Sinop, so many visitors fly there. This transfer must be booked in advance.' },
  { q: 'Do I need to rent a car for my holiday?', a: 'Usually not. Ayancık town centre and the beach are within walking distance, and car rental options in the district are very limited. A car is only really needed for day trips to Akgöl, the caves, the waterfalls and the quieter coves — which is often just a few days of a longer stay.' },
  { q: 'Is it safe to swim in Ayancık?', a: 'On calm days, yes. Ayancık harbour faces the open sea, so waves build up quickly in northerly and north-westerly winds; the district has around 9 stormy days a year. Sea temperature averages 23–24 °C in June and July. If the sea looks rough, Hamsilos Bay near Sinop is sheltered and a safer choice.' },
];
---
<Base
  lang="en"
  title="Taxi in Ayancık, Sinop | 24/7 Airport & Beach Transfers"
  description="Licensed 24/7 taxi in Ayancık, Sinop (Turkey). Sinop Airport transfers, beach day trips, village and long-distance rides. WhatsApp in English."
  path="/en/"
  alternates={alternates}
  waMessage={waMessages.en}
  schema={[faqSchema(faq)]}
>
  <section class="hero">
    <div class="wrap hero__grid">
      <div>
        <p class="hero__badges">
          <span class="hero__badge"><Icon name="clock" /> Open 24 hours, every day</span>
          <span class="hero__badge"><Icon name="pin" /> Ayancık + 64 villages</span>
          <span class="hero__badge"><Icon name="shield" /> Licensed commercial driver</span>
        </p>
        <h1>Taxi in Ayancık, on the Turkish Black Sea coast</h1>
        <p class="hero__sub">
          A local, licensed taxi based in Ayancık (Sinop province). Airport transfers,
          beach and nature day trips, hospital and village rides — at a fixed price
          agreed before you set off. You can message us in English.
        </p>
        <a class="hero__phone" href={site.phone.href}>
          <Icon name="phone" /> {site.phone.displayIntl}
        </a>
        <div style="margin-top:1.3rem">
          <CallButtons lang="en" size="lg" waMessage={waMessages.en} showNumber={false} />
        </div>
        <p class="fs-sm" style="margin-top:1rem;color:#8f9bab">
          Sharing your live location on WhatsApp is the fastest way to be found.
        </p>
      </div>
      <aside class="hero-card">
        <h2>At a glance</h2>
        <dl>
          <div><dt>Opening hours</dt><dd>24/7, all year</dd></div>
          <div><dt>Ayancık → Sinop Airport</dt><dd>60 km · ~1 h 5 min</dd></div>
          <div><dt>Ayancık → Sinop city</dt><dd>55 km · ~1 h</dd></div>
          <div><dt>Ayancık → Samsun Airport</dt><dd>250 km · ~3.5 h</dd></div>
          <div><dt>Payment</dt><dd>Cash · Credit card</dd></div>
          <div><dt>Languages</dt><dd>Turkish · English · German</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <section class="section" id="services">
    <div class="wrap">
      <p class="eyebrow">What we do</p>
      <h2>Services</h2>
      <div class="grid grid--3" style="margin-top:1.8rem">
        {svc.map((s) => (
          <div class="card">
            <span class="icon-badge"><Icon name={s.icon} /></span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
      <p style="margin-top:1.8rem"><a class="btn btn--ghost" href="/en/sinop-airport-transfer/">Sinop Airport transfer details <Icon name="arrow" /></a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <p class="eyebrow">Distances</p>
      <h2>How far is everything from Ayancık?</h2>
      <div class="table-wrap" style="margin-top:1.6rem">
        <table>
          <caption>Approximate road distances and driving times in normal conditions.</caption>
          <thead><tr><th scope="col">Destination</th><th scope="col" class="num">Distance</th><th scope="col" class="num">Time</th></tr></thead>
          <tbody>
            {[...routes].sort((a,b)=>a.km-b.km).map((r) => (
              <tr><th scope="row" style="font-weight:640">{r.to}</th><td class="num tabnum">{r.km} km</td><td class="num tabnum nowrap">{fmtDuration(r.minutes).replace(' sa',' h').replace(' dk',' min')}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid--2" style="align-items:center">
        <div>
          <p class="eyebrow">Good to know</p>
          <h2>Ayancık in practice</h2>
          <p class="lead">
            A town of about 23,000 people where the Ayancık stream meets the open Black Sea,
            backed by the Çangal forests. Beautiful, but with very little public transport
            once you leave the centre.
          </p>
        </div>
        <ul class="ticks" style="font-size:1.02rem">
          <li><strong>No airport bus.</strong> There is no public transport link between Sinop Airport and Ayancık — a pre-booked transfer is the only reliable option, especially for night flights.</li>
          <li><strong>Villages are hard to reach.</strong> Minibuses serve the 64 villages only a few times a day, and timetables shift with the season.</li>
          <li><strong>The sea can turn rough.</strong> The harbour faces the open sea; northerly winds raise waves quickly. Hamsilos Bay (60 km) is sheltered.</li>
          <li><strong>Forest roads need local knowledge.</strong> Akgöl and İnaltı Cave are on unsealed forest roads with patchy phone coverage.</li>
          <li><strong>September is the best month.</strong> Sea still warm, crowds gone, air fresher.</li>
          <li><strong>Carry cash.</strong> Cards are not accepted everywhere outside the centre.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="faq">
    <div class="wrap narrow">
      <p class="eyebrow">FAQ</p>
      <h2>Frequently asked questions</h2>
      <div style="margin-top:1.6rem"><Faq items={faq} open={0} /></div>
    </div>
  </section>

  <section class="section section--ink center">
    <div class="wrap narrow">
      <h2>Need a taxi in Ayancık?</h2>
      <p class="lead" style="margin-inline:auto">
        Call, or send a WhatsApp message with your location, date and time. Same number,
        day or night.
      </p>
      <div style="margin-top:1.8rem;display:flex;justify-content:center">
        <CallButtons lang="en" size="lg" waMessage={waMessages.en} />
      </div>
      <p class="fs-sm" style="margin-top:1.4rem">
        <a href="/">Türkçe</a> · <a href="/de/">Deutsch</a>
      </p>
    </div>
  </section>
</Base>
