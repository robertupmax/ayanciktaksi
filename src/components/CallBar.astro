---
import { site, waMessages } from '../data/site';
import Icon from './Icon.astro';
interface Props { lang?: 'tr' | 'en' | 'de'; waMessage?: string }
const { lang = 'tr', waMessage } = Astro.props;
const msg = waMessage ?? (lang === 'en' ? waMessages.en : lang === 'de' ? waMessages.de : waMessages.location);
const t = {
  tr: { call: 'Hemen Ara', wa: 'Konum At' },
  en: { call: 'Call Now', wa: 'WhatsApp' },
  de: { call: 'Anrufen', wa: 'WhatsApp' },
}[lang];
---
<div class="callbar" role="group" aria-label={lang === 'tr' ? 'Hızlı iletişim' : 'Quick contact'}>
  <a class="btn btn--call" href={site.phone.href} data-call="callbar">
    <Icon name="phone" /> {t.call}
  </a>
  <a class="btn btn--wa" href={site.whatsapp.href(msg)} target="_blank" rel="noopener" data-call="callbar-wa">
    <Icon name="whatsapp" /> {t.wa}
  </a>
</div>
