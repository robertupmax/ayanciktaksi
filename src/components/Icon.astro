  hospital: '<path d="M12 2 3 6v6c0 5.25 3.6 9.74 9 11 5.4-1.26 9-5.75 9-11V6l-9-4z"/><path d="M12 8v8M8 12h8" stroke="#fff" stroke-width="2" stroke-linecap="round" fill="none"/>',
